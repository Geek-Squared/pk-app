{
  "buildCommand": "npm run build",
  "outputDirectory": "www",
  "installCommand": "npm install --legacy-peer-deps",
  "framework": "angular",
  "rewrites": [
    {
      "source": "/delete-account",
      "destination": "/delete-account.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}